<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="fi.abo.grupp12pvp.controller.CustomerController"
      stylesheets="@styles.css"
      spacing="10" prefWidth="400" prefHeight="700" style="-fx-padding: 20;">

    <!--Produkter och totalsumma syns alltid-->
    <Label text="Your Items" styleClass="title"/>
    <ListView fx:id="customerItemListView" prefHeight="160" VBox.vgrow="NEVER"/>
    <Button fx:id="removeButton"
            text="Remove Selected Item"
            onAction="#handleRemoveSelected"/>
    <Label fx:id="customerTotalLabel" styleClass="total-label" text="Total: €0.00"/>

    <!--Remaining sum to pay-->
    <Label fx:id="remainingLabel" text="Remaining sum to pay: 0.00" style="-fx-font-weight: bold; -fx-text-fill: #333333"/>

    <!--Payment options panel-->
    <VBox fx:id="paymentOptionsPane" spacing="10">

        <!--Card-->
        <Label text="Card Payment" styleClass="customer-section-title"/>
        <TextField fx:id="cardAmountField"
                   promptText="Amount"/>
        <Button fx:id="cardPaymentButton"
                text="Pay by card"
                onAction="#handleCardPayment"/>
        <Label fx:id="cardPaymentStatusLabel"/>
        <Label fx:id="cardPaidLabel" text="Paid by card: 0.00€"/>

        <!--Cash-->
        <Label text="Cash Payment" styleClass="customer-section-title"/>
        <TextField fx:id="cashAmountField" promptText="Amount"/>
        <Button fx:id="cashPaymentButton"
                text="Pay by cash"
                onAction="#handleCashPayment"/>
        <Label fx:id="cashPaymentStatusLabel"/>
        <Label fx:id="cashPaidLabel" text="Paid by cash: 0.00"/>

    </VBox>

    <!-- Approved Panel & Change -->
    <VBox fx:id="approvedPane" spacing="15" alignment="CENTER" visible="false" managed="false">
        <Label text="Purchase approved!" styleClass="approved-title"/>
        <Label fx:id="changeLabel" text="Change: 0.00" style="-fx-font-weight: bold;"/>

        <!--Receipt choice-->
        <VBox fx:id="receiptChoice" spacing="10" alignment="CENTER">
            <Label text="Would you like a receipt?" styleClass="customer-section-title"/>
            <HBox spacing="10" alignment="CENTER">
                <Button text="Yes" onAction="#handleShowReceipt"/>
                <Button text="No" onAction="#handleApprove"/>
            </HBox>
        </VBox>

        <!--Show receipt -->
        <VBox fx:id="receiptShow" spacing="10" alignment="CENTER" visible="false" managed="false">
            <Label text="RECEIPT" styleClass="receipt-title"/>
            <Label fx:id="receiptTextLabel" styleClass="receipt-text" wrapText="true"/>
            <Button text="Print receipt" onAction="#handlePrintReceipt"/>
            <Button text="Done" onAction="#handleApprove"/>
        </VBox>
    </VBox>


</VBox>
