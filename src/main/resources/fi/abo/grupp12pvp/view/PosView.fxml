<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="10.0"
      prefWidth="500.0"
      prefHeight="500.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="fi.abo.grupp12pvp.controller.PosController"
      stylesheets="@styles.css">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <children>
        <Label text="Point of Sale System" styleClass="title"/>
        <TextField fx:id="scanField" promptText="Scan barcode" maxWidth="350.0"/>
        <Button fx:id="scanButton" text="Scan item" defaultButton="true"/>
        <Label text="Scanned items" styleClass="items-label"/>
        <ListView fx:id="itemListView" prefHeight="250.0"/>
        <Label fx:id="totalLabel" text="Total: €0.00" styleClass="total-label"/>
        <Label fx:id="cardPaymentStatusLabel" text="Card payment"
               styleClass="items-label"/>
        <TextField fx:id="cardAmountField"
                   promptText="Amount to pay by card"
                   maxWidth="200.0"/>
        <Button fx:id="cardPaymentButton"
                text="Pay by card"/>
    </children>
</VBox>