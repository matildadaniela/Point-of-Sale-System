<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.layout.FlowPane?>
<VBox spacing="10.0"
      prefWidth="500.0"
      prefHeight="500.0"
      xmlns="http://javafx.com/javafx/25"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="fi.abo.grupp12pvp.controller.PosController"
      stylesheets="@styles.css">
    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <children>
        <Label text="Point of Sale System" styleClass="title"/>
        <TextField fx:id="scanField" promptText="Scan barcode" maxWidth="350.0"/>
        <Button fx:id="scanButton" text="Scan item" defaultButton="true"/>
        <Button fx:id="removeButton" text="Remove Selected"/>
        <Button fx:id="shelveButton" text="Shelve Sale"/>
        <Label text="Shelved Sales" styleClass="items-label"/>
        <ListView fx:id="shelvedSalesListView" prefHeight="100.0"/>
        <Button fx:id="resumeButton" text="Resume Selected Sale"/>
        <Label text="Product Catalogue - Add items by clicking on the products" styleClass="items-label"/>
        <FlowPane fx:id="productCataloguePane" hgap="10" vgap="10"/>
        <Label text="Shopping cart" styleClass="items-label"/>
        <ListView fx:id="itemListView" prefHeight="250.0"/>
        <Label fx:id="totalLabel" text="Total: €0.00" styleClass="total-label"/>
        <Label fx:id="cardStatusLabel" text="" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
        <Label fx:id="cashChangeLabel" text="" style="-fx-font-weight: bold; -fx-text-fill: #333333;"/>
        <Label fx:id="overallStatusLabel" text="" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: green;"/>
        <Button text="Close cashbox" onAction="#closeCashBox"/>
    </children>
</VBox>